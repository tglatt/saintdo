---
import { createAdminClient } from '../../lib/supabase';
import AdminNav from '../../components/AdminNav.astro';
import '../../styles/theme.css';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');

const supabase = createAdminClient();

const { data: candidatures } = await supabase
  .from('porteurs_projet')
  .select('id, created_at, email, nom, prenom, intitule_projet, reponses')
  .order('created_at', { ascending: false });

function fmtDate(iso: string) {
  return new Date(iso).toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric' });
}

const stadeLabel: Record<string, string> = {
  reflexion: 'Projet en réflexion',
  statuts_deposes: 'Statuts déposés',
  existant: 'Cherche un nouveau local',
};
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Porteurs de projet — Admin Saint Domingue</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>

  <AdminNav activePage="porteurs-projet" userEmail={user.email} />

  <main>
    <div class="container">

      <header class="page-header">
        <h1>Porteurs de projet</h1>
        <p class="sub">Réponses au questionnaire "J'ai un projet".</p>
      </header>

      <section class="section">
        <div class="section-header">
          <h2>Candidatures ({candidatures?.length ?? 0})</h2>
        </div>

        {candidatures && candidatures.length > 0 ? (
          <div class="table-wrapper">
            <table>
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Projet</th>
                  <th>Contact</th>
                  <th>Email</th>
                  <th>Avancement</th>
                  <th class="th-actions"></th>
                </tr>
              </thead>
              <tbody>
                {candidatures.map(c => (
                  <tr class="clickable" onclick={`window.location='/admin/porteurs-projet/${c.id}'`}>
                    <td class="muted">{fmtDate(c.created_at)}</td>
                    <td class="bold">{c.intitule_projet || '—'}</td>
                    <td>{[c.prenom, c.nom].filter(Boolean).join(' ') || '—'}</td>
                    <td class="muted">{c.email}</td>
                    <td class="muted">{stadeLabel[c.reponses?.vous_et_votre_projet?.stade_avancement] ?? '—'}</td>
                    <td class="td-actions">
                      <button
                        type="button"
                        class="btn-delete"
                        title="Supprimer la candidature"
                        aria-label="Supprimer la candidature"
                        data-delete-id={c.id}
                        data-delete-label={c.intitule_projet || [c.prenom, c.nom].filter(Boolean).join(' ') || c.email}
                      >✕</button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="empty">Aucune candidature pour le moment.</p>
        )}
      </section>

    </div>
  </main>

  <!-- MODAL SUPPRIMER CANDIDATURE -->
  <div id="delete-overlay" class="modal-overlay hidden">
    <div class="modal">
      <div class="modal-header">
        <h2>Supprimer la candidature</h2>
        <button type="button" class="modal-close" data-modal-close>✕</button>
      </div>
      <div class="modal-body">
        <p class="modal-desc">
          Cette action est irréversible. La candidature <strong id="delete-label"></strong> et toutes ses réponses seront définitivement supprimées.
        </p>
        <p id="delete-error" class="form-error hidden"></p>
        <div class="form-actions">
          <button type="button" data-modal-close>Annuler</button>
          <button type="button" id="delete-confirm" class="btn-action-danger">Supprimer</button>
        </div>
      </div>
    </div>
  </div>

</body>
</html>

<script>
  const overlay     = document.getElementById('delete-overlay');
  const labelEl     = document.getElementById('delete-label');
  const errorEl     = document.getElementById('delete-error');
  const confirmBtn  = document.getElementById('delete-confirm');
  let currentId = null;

  function closeModal() { overlay.classList.add('hidden'); }

  overlay.addEventListener('click', e => { if (e.target === overlay) closeModal(); });
  overlay.querySelectorAll('[data-modal-close]').forEach(el => el.addEventListener('click', closeModal));

  document.querySelectorAll('[data-delete-id]').forEach(btn => {
    btn.addEventListener('click', e => {
      e.stopPropagation();
      currentId = btn.dataset.deleteId;
      labelEl.textContent = btn.dataset.deleteLabel;
      errorEl.classList.add('hidden');
      confirmBtn.disabled = false;
      confirmBtn.textContent = 'Supprimer';
      overlay.classList.remove('hidden');
    });
  });

  confirmBtn.addEventListener('click', async () => {
    if (!currentId) return;
    confirmBtn.disabled = true;
    confirmBtn.textContent = 'Suppression…';
    errorEl.classList.add('hidden');

    const res = await fetch(`/api/admin/porteur-projet?id=${currentId}`, { method: 'DELETE' });
    if (!res.ok) {
      errorEl.textContent = await res.text() || 'Erreur lors de la suppression';
      errorEl.classList.remove('hidden');
      confirmBtn.disabled = false;
      confirmBtn.textContent = 'Supprimer';
      return;
    }
    window.location.reload();
  });
</script>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Inter', system-ui, sans-serif;
    background: var(--color-bg);
    color: var(--color-text);
    min-height: 100vh;
  }

  main { padding: 48px 24px; }
  .container { max-width: 1200px; margin: 0 auto; }

  .page-header { margin-bottom: 32px; }
  h1 {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    color: var(--color-primary);
    margin-bottom: 8px;
  }
  .sub { color: var(--color-muted); }

  .section { margin-bottom: 40px; }
  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  .section-header h2 {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    color: var(--color-primary);
  }

  .table-wrapper { overflow-x: auto; }
  table {
    width: 100%;
    border-collapse: collapse;
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0,0,0,0.05);
    min-width: 640px;
  }
  th {
    text-align: left;
    padding: 12px 16px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }
  td {
    padding: 12px 16px;
    font-size: 0.88rem;
    border-bottom: 1px solid var(--color-border-light);
  }
  tr:last-child td { border-bottom: none; }
  .bold { font-weight: 600; }
  .muted { color: var(--color-muted); }
  .clickable { cursor: pointer; transition: background 0.1s; }
  .clickable:hover td { background: var(--color-bg); }

  .empty { color: var(--color-muted); font-size: 0.9rem; padding: 24px 0; }

  .th-actions, .td-actions { width: 48px; text-align: right; }
  .btn-delete {
    background: none;
    border: none;
    color: var(--color-subtle);
    font-size: 0.9rem;
    line-height: 1;
    padding: 6px 8px;
    border-radius: 6px;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s;
  }
  .btn-delete:hover { color: var(--color-error); background: #fff0f0; }

  /* Modal */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.45);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .modal-overlay.hidden { display: none; }
  .modal {
    background: white;
    border-radius: 16px;
    width: 100%;
    max-width: 420px;
    box-shadow: 0 8px 48px rgba(0,0,0,0.18);
  }
  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28px 28px 20px;
    border-bottom: 1px solid var(--color-border-light);
  }
  .modal-header h2 {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    color: var(--color-primary);
  }
  .modal-close { background: none; border: none; font-size: 1.1rem; color: var(--color-subtle); cursor: pointer; padding: 4px 8px; }
  .modal-close:hover { color: var(--color-text); }
  .modal-body { padding: 24px 28px; }
  .modal-desc { font-size: 0.9rem; color: var(--color-text); line-height: 1.6; margin-bottom: 20px; }
  .form-error {
    font-size: 0.85rem;
    color: var(--color-error);
    margin-bottom: 16px;
  }
  .form-error.hidden { display: none; }
  .form-actions { display: flex; gap: 12px; justify-content: flex-end; }
  .form-actions button {
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    border: none;
    font-family: inherit;
    background: var(--color-bg);
    color: var(--color-muted);
    transition: all 0.2s;
  }
  .form-actions button:hover { background: var(--color-border); }
  .btn-action-danger { background: var(--color-error); color: white; }
  .btn-action-danger:hover { opacity: 0.88; background: var(--color-error); }
  .btn-action-danger:disabled { opacity: 0.6; cursor: not-allowed; }
</style>
